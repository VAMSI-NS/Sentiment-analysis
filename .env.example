# Frontend build-time API endpoint. Set to the deployed FastAPI service URL.
VITE_API_BASE_URL=http://127.0.0.1:8000

# FastAPI backend configuration. Leave DATABASE_URL unset for local SQLite.
# On Render, set DATABASE_URL to the internal connection string of a Render PostgreSQL database.
DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,https://sentiment-analysis-frontend-y6rc.onrender.com
DEAN_EMAIL=vignan.admin@gmail.com
# Configure a strong initial password as a secret in the backend service environment.
DEAN_INITIAL_PASSWORD=
SESSION_COOKIE_SECURE=false
